# 环境变量样例：复制为 .env 后按需修改；不复制也能跑（全部使用下面的默认值）。
#
#   cp .env.example .env && vi .env
#
# ⚠️ .env 里有 WebDAV 口令，已经在 .gitignore 里，别提交。

# ---------------------------------------------------------------------------
# 挂载位置
# ---------------------------------------------------------------------------

# 网盘在 NAS 上出现的位置。默认 /volume1/data/网盘 在 NAS 上可见、SMB 可共享，
# 但**不属于任何「空间」**，铁牛文件管理器里看不到。
# 想在「我的文件」里看到，填 /volume1/data/personal/<你的用户ID>/网盘。
# ⚠️ 必须是专用空目录 —— 它会被本应用接管为挂载点。
MOUNT_DIR=/volume1/data/网盘

# 共享进容器的宿主目录，**这就是容器的可见边界，填得越窄越安全**。
# 正确做法是填「挂载目录的上一级」：挂载点是 /volume1/data/personal/1000/网盘，
# 这里就填 /volume1/data/personal/1000 —— 容器里只剩你的个人空间，
# 看不到 AList 的凭据库（/volume1/data/alist/data.db 里存着网盘登录凭据）。
# 默认的 /volume1/data 那棵子树里包含 alist/，等于没挡住。
SHARE_ROOT=/volume1/data

# 读缓存的宿主目录。容器内固定挂在 /cmcache（容器内目标必须与宿主不同路径）。
CACHE_HOST_DIR=/volume1/data/cloudmount

# ---------------------------------------------------------------------------
# 挂载文件的属主
# ---------------------------------------------------------------------------

# 留空是 0（root），这样文件在宿主上是 root 私有的，一旦开 SMB 共享，
# Windows 侧会把这些文件当成只读 —— 改名、编辑、删除都会失败。
# 想跟个人空间一致就填你自己的 UID / GID：id -u <用户名> / id -g <用户名>
MOUNT_UID=0
MOUNT_GID=0

# ---------------------------------------------------------------------------
# WebDAV 上游（推荐本机 AList）
# ---------------------------------------------------------------------------

# 默认指向本机 AList。也可以填别的 WebDAV 服务器。
WEBDAV_URL=http://host.docker.internal:5244/dav

# AList 的管理员账号名
WEBDAV_USER=admin

# ⚠️ 如果你在 AList 后台改过管理员口令，这里必须填成新的，否则挂载会一直空着。
#    口令请勿包含英文双引号（会破坏生成的编排文件）。
WEBDAV_PASSWORD=admin

# ---------------------------------------------------------------------------
# 读缓存（一般不用改）
# ---------------------------------------------------------------------------

# 缓存上限与模式。WebDAV 不支持流式读写，mode 必须开缓存。
VFS_CACHE_MAX_SIZE=20G
VFS_CACHE_MODE=full

# ---------------------------------------------------------------------------
# 配置页（可选，需要宿主有 python3）
# ---------------------------------------------------------------------------

# 配置页监听端口与绑定地址
# CM_PANEL_PORT=8791
# CM_PANEL_BIND=0.0.0.0

# 配置页访问口令。留空 = 首次打开页面时由访问者自行设置（会存到数据目录，
# 只存 PBKDF2 哈希）。填了则优先级最高，每次启动都以它为准。
# 忘了口令的兜底：删掉数据目录下的 .panel-auth.json 再重启配置页。
# PANEL_PASSWORD=

# 配置页认得的其它环境变量（一般不用填）：
#   CM_APP_DIR    应用目录，默认 /volume1/@appstore/com.centerm.docker.cloudmount
#   CM_DATA_DIR   数据目录，默认 /volume1/data/cloudmount
#   CM_CONTAINER  要重启的容器名，默认 cloudmount-app
